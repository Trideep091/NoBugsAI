# NoBugs AI Configuration Environment Variables

# Application
APP_NAME="NoBugs AI"
DEBUG=false

# Database (SQLite by default, or PostgreSQL e.g. postgresql://user:pass@localhost:5432/nobugs)
DATABASE_URL="sqlite:///./nobugs.db"

# Local AI Engine (Ollama)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2:latest"
OLLAMA_TIMEOUT_SECONDS=60.0
ALLOW_OFFLINE_MOCK_FALLBACK=true

# Upload Limits
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_LINES_PER_FILE=50000

# Redaction
ENABLE_SECRET_REDACTION=true
